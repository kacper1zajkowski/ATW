<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-PrepareWeatherRequest">
  <DisplayName>AM-PrepareWeatherRequest</DisplayName>
  <AssignTo createNew="true" transport="http" type="request">weatherRequest</AssignTo>
  <Set>
    <Verb>GET</Verb>
    <QueryParams>
      <QueryParam name="latitude">{location.lat}</QueryParam>
      <QueryParam name="longitude">{location.lon}</QueryParam>
      <QueryParam name="current">temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,wind_direction_10m,surface_pressure,visibility,weather_code,uv_index,uv_index_clear_sky</QueryParam>
      <QueryParam name="daily">temperature_2m_max,temperature_2m_min,weather_code,precipitation_probability_max,wind_speed_10m_max,uv_index_max,sunrise,sunset</QueryParam>
      <QueryParam name="forecast_days">7</QueryParam>
      <QueryParam name="wind_speed_unit">kmh</QueryParam>
      <QueryParam name="timezone">auto</QueryParam>
    </QueryParams>
  </Set>
  <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
</AssignMessage>
