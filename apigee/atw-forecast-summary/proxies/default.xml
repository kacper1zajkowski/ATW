<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>FC-Common</Name>
      </Step>
      <Step>
        <Name>JS-BuildGeminiPrompt</Name>
      </Step>
      <Step>
        <Name>AM-PrepareGeminiRequest</Name>
      </Step>
      <Step>
        <Name>SC-Gemini</Name>
      </Step>
      <Step>
        <Name>JS-ExtractSummary</Name>
      </Step>
      <Step>
        <Name>AM-BuildResponse</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <HTTPProxyConnection>
    <BasePath>/v1/forecast-summary</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="noroute"/>
</ProxyEndpoint>
